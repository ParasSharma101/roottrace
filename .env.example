# ==========================================
# RootTrace Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env with real secrets to Git
# ==========================================

# PostgreSQL Configuration
POSTGRES_DB=roottrace
POSTGRES_USER=roottrace_app
POSTGRES_PASSWORD=roottrace_secret_change_me
POSTGRES_PORT=5433

# Redis Configuration
REDIS_PORT=6379

# Kafka Configuration
KAFKA_PORT=9092

# External Integrations (Backend)
GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_TOKEN=your_github_pat_here

# Demo tools are disabled by default. Backend opt-in additionally requires the dev profile.
# Set these in the respective application process; Spring/Next do not read this root file automatically.
ROOTTRACE_DEMO_ENABLED=false
NEXT_PUBLIC_DEMO_ENABLED=false

# Required outside the dev profile. Supply independent randomly generated secrets.
# Leave blank only for local dev; production startup fails with blank values.
ROOTTRACE_JWT_SECRET=
ROOTTRACE_INGESTION_KEY=
ROOTTRACE_BREAKGLASS_ENABLED=false

# Email is opt-in. See backend/EMAIL_INVITATIONS.md before enabling it.
ROOTTRACE_MAIL_ENABLED=false
ROOTTRACE_MAIL_FROM=roottrace@localhost.invalid
ROOTTRACE_PUBLIC_APP_URL=
# Base64-encoded 32 random bytes, independent of signing/ingestion secrets.
ROOTTRACE_MAIL_ENCRYPTION_KEY=
ROOTTRACE_SMTP_HOST=localhost
ROOTTRACE_SMTP_PORT=587
ROOTTRACE_SMTP_USERNAME=
ROOTTRACE_SMTP_PASSWORD=
ROOTTRACE_SMTP_AUTH=true
ROOTTRACE_SMTP_STARTTLS=true
ROOTTRACE_SMTP_SSL=false
